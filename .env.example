NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o-mini

META_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set either a WhatsApp sender (for example, whatsapp:+14155550123)
# or the Messaging Service selected in Twilio Console.
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Optional: enable round-robin auto assignment for new conversations.
AUTO_ASSIGN_CHATS=false

# Optional: bulk WhatsApp campaign tuning.
# CAMPAIGN_BATCH_SIZE=25          # recipients handled per worker invocation
# CAMPAIGN_SEND_INTERVAL_MS=250   # gap between sends, to respect Twilio rate limits
# CAMPAIGN_MAX_RECIPIENTS=5000    # hard ceiling on one campaign's audience
# CAMPAIGN_WORKER_SECRET=         # defaults to a hash of the service role key
# Needed only if the deployment origin cannot be read from request headers.
# NEXT_PUBLIC_APP_URL=https://your-crm.vercel.app
